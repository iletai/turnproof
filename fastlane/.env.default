# Shared, non-secret values. Per-environment values: .env.dev / .env.staging / .env.prod,
# selected with `bundle exec fastlane <lane> --env dev|staging|prod` (contract: references/environments.md).
XCODE_PROJECT=Turnproof.xcodeproj
TEST_SCHEME=Turnproof-Dev
# Comma list of App ID capabilities `bootstrap` enables on every env bundle id, e.g. APP_GROUPS,ICLOUD,IN_APP_PURCHASE.
CAPABILITIES=
APPLE_TEAM_ID=AP58YLHQ2S
# UI snapshot tests run only through `fastlane screenshots`, not in CI `test`.
SCAN_SKIP_TESTING=TurnproofUITests
# Landing site (apps-site); metadata *_url.txt files were generated from it.
SITE_BASE_URL=https://apps-site-six.vercel.app
