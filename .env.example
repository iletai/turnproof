# Copy to .env (gitignored, chmod 600). Non-secret app values live in fastlane/.env.default.
# Every name below is also a GitHub secret (gh secret set -f .env).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT_BASE64=
MATCH_GIT_URL=
MATCH_PASSWORD=
MATCH_SSH_KEY=
FASTLANE_KEYCHAIN_PASSWORD=
APPLE_TEAM_ID=
# Optional: App Review contact (if unset, App Store Connect keeps the existing contact)
APP_REVIEW_FIRST_NAME=
APP_REVIEW_LAST_NAME=
APP_REVIEW_EMAIL=
APP_REVIEW_PHONE=
# Optional: fine-grained PAT (Contents: read-only) if the app depends on a private iletai Swift package.
PRIVATE_REPO_TOKEN=
